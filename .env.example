# =============================================================================
# نمونه فایل محیط. این فایل را کپی کنید به .env و مقادیر واقعی را جایگزین کنید.
# هرگز فایل .env واقعی را در مخزن گیت commit نکنید.
# =============================================================================

# --- عمومی ---
NODE_ENV=development
# آدرس عمومی سایت (برای لینک‌های داخلی، callback پرداخت و sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PORT=3000
# منطقه زمانی کسب‌وکار (زمان‌ها در دیتابیس UTC ذخیره می‌شوند، این مقدار فقط برای محاسبه
# ساعت محلی هنگام زمان‌بندی پیام و نمایش استفاده می‌شود)
BUSINESS_TIMEZONE=Asia/Tehran

# مسیر فایل تنظیمات Payload (برای CLI: migrate, generate:types و ...)
PAYLOAD_CONFIG_PATH=src/payload.config.ts

# --- دیتابیس ---
# POSTGRES_PASSWORD توسط docker-compose.yml هم برای ساخت کانتینر postgres و هم در
# DATABASE_URI کانتینرهای app/worker استفاده می‌شود؛ اینجا و در رشته اتصال زیر هماهنگ نگه دارید.
POSTGRES_PASSWORD=sara_dev_password
DATABASE_URI=postgres://sara:sara_dev_password@localhost:5432/sara_naghizadeh

# --- Payload CMS ---
# یک رشته تصادفی طولانی و امن بسازید؛ هرگز مقدار پیش‌فرض یا نمونه را در تولید استفاده نکنید.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- کوکی نشست هنرجو (JWT سفارشی جدا از Payload) ---
# رشته تصادفی طولانی و متفاوت از PAYLOAD_SECRET
STUDENT_JWT_SECRET=change-me-to-another-long-random-string
STUDENT_SESSION_COOKIE_NAME=sn_student_session

# --- ذخیره‌سازی سازگار با S3 (در توسعه محلی: MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sara_minio_admin
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=media-public
S3_BUCKET_PRIVATE=media-private
# آدرسی که مرورگر برای دیدن فایل‌های عمومی استفاده می‌کند (در تولید: CDN یا دامنه واقعی)
S3_PUBLIC_URL_PROTOCOL=http
S3_PUBLIC_URL_HOSTNAME=localhost
S3_PUBLIC_URL_PORT=9000
S3_PUBLIC_BASE_URL=http://localhost:9000/media-public

# سقف حجم آپلود (مگابایت) و فرمت‌های مجاز
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_VIDEO_MB=2048
UPLOAD_MAX_DOC_MB=25

# --- OTP ورود هنرجو ---
OTP_CODE_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# فقط برای آزمون خودکار (Playwright)؛ کد OTP را در پاسخ API برمی‌گرداند. هرگز true در تولید.
ALLOW_OTP_DEBUG_RESPONSE=false

# --- درگاه پرداخت ---
# مقدار مجاز: mock | zarinpal
# اگر zarinpal انتخاب شود ولی ZARINPAL_MERCHANT_ID خالی باشد و NODE_ENV=production باشد،
# مسیر پرداخت با خطای صریح مسدود می‌شود (پرداخت آزمایشی در تولید مجاز نیست).
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_PATH=/api/payments/zarinpal/callback

# --- ارسال پیامک ---
# مقدار مجاز: mock | kavenegar
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER_LINE=

# --- worker صف پیام / کارهای زمان‌بندی‌شده ---
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_ATTEMPTS=5
WORKSHOP_HOLD_MINUTES=15
WORKSHOP_REMINDER_HOURS_BEFORE=24

# --- ساخت اولین مدیر (فقط برای اسکریپت scripts/create-first-admin.ts) ---
# اگر خالی بگذارید، اسکریپت به‌صورت تعاملی از شما می‌پرسد یا رمز تصادفی امن می‌سازد.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
